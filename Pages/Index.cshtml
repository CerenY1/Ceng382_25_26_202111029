@page
@model RazorPage.Pages.IndexModel
@{
    ViewData["Title"] = "Class Management";
}

<style>
    body {
        background: linear-gradient(to right, #dbeafe, #bfdbfe);
        color: #333;
        font-family: 'Poppins', sans-serif;
    }

    .container { margin-top: 30px; }

    .card {
        border-radius: 15px;
        box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.1);
        padding: 20px;
        background-color: white;
        transition: 0.3s;
    }

    .card:hover { transform: scale(1.02); }

    .table {
        background-color: white;
        border-radius: 10px;
        overflow: hidden;
        color: #333;
    }

    th {
        background-color: #3b82f6;
        color: white;
        text-transform: uppercase;
        cursor: pointer;
        transition: 0.3s;
    }

    th.selected-column {
        background-color: #5778e3 !important;
        color: white !important;
    }

    td.selected-cell {
        background-color: #e0f2fe !important;
    }

    tr:nth-child(even) { background-color: #f1f5f9; }

    tr:hover { background-color: #e0f2fe; transition: 0.3s; }

    .btn-primary {
        background-color: #2563eb;
        border-color: #2563eb;
        border-radius: 10px;
        transition: 0.3s;
    }

    .btn-primary:hover { background-color: #1e40af; }

    .btn-danger {
        background-color: #ef4444;
        border-color: #ef4444;
        border-radius: 10px;
        transition: 0.3s;
    }

    .btn-danger:hover { background-color: #b91c1c; }
</style>

<div class="container">
    <div class="row">
  
        <div class="col-md-4">
            <div class="card">
                <h2 class="text-center text-primary">
                    @(Model.EditId.HasValue ? "Edit Class" : "Add New Class")
                </h2>
                <form method="post" asp-page-handler="@(Model.EditId.HasValue ? "Edit" : "Add")">
                    <input type="hidden" asp-for="EditId" />
                    <div class="form-group">
                        <label><strong>Class Name</strong></label>
                        <input type="text" asp-for="NewClass.ClassName" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label><strong>Student Count</strong></label>
                        <input type="number" asp-for="NewClass.StudentCount" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label><strong>Description</strong></label>
                        <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mt-3">
                        @(Model.EditId != null ? "Update" : "Add")
                    </button>
                </form>
            </div>
        </div>

   
        <div class="col-md-8">
            <div class="card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="text-primary mb-0">Class List</h2>

                    <form method="post" asp-page-handler="Export" id="exportForm" class="d-flex align-items-center">
                        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                        <input type="hidden" name="FilterByName" value="@Model.FilterByName" />
                        <input type="hidden" name="SelectedColumns" id="selectedColumnsInput" />
                        <button type="submit" class="btn btn-primary ml-2">Export</button>
                    </form>
                </div>

                <form method="get" class="mb-3 d-flex">
                    <input type="text" name="FilterByName" class="form-control mr-2"
                           value="@Model.FilterByName" placeholder="Filter by class name" />
                    <button type="submit" class="btn btn-primary">Filter</button>
                </form>

                <table class="table table-hover table-bordered" id="classTable">
                    <thead>
                        <tr>
                            <th data-col="Class Name" class="clickable-header">Class Name</th>
                            <th data-col="Student Count" class="clickable-header">Student Count</th>
                            <th data-col="Description" class="clickable-header">Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.FilteredClasses) 
                        {
                            <tr>
                                <td data-col="Class Name">@item.ClassName</td>
                                <td data-col="Student Count">@item.StudentCount</td>
                                <td data-col="Description">@item.Description</td>
                                <td>
                                    <div class="d-flex justify-content-start">
                                        <form method="post" asp-page-handler="StartEdit" class="me-3 mb-0">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-primary btn-sm">Edit</button>
                                        </form>
                                        <form method="post" asp-page-handler="Delete" class="mb-0">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="text-center">
                    <p>Page @Model.PageNumber of @Model.TotalPages</p>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <a asp-page="./Index"
                           asp-route-PageNumber="@i"
                           asp-route-FilterByName="@Model.FilterByName"
                           class="btn btn-sm @(i == Model.PageNumber ? "btn-primary" : "btn-outline-primary") mx-1">
                            @i
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const headers = document.querySelectorAll('.clickable-header');
        const selectedInput = document.getElementById('selectedColumnsInput');
        const selectedSet = new Set();

        headers.forEach(header => {
            header.addEventListener('click', function () {
                const colName = header.getAttribute('data-col');
                const cells = document.querySelectorAll(`td[data-col='${colName}']`);

                if (selectedSet.has(colName)) {
                    selectedSet.delete(colName);
                    header.classList.remove('selected-column');
                    cells.forEach(cell => cell.classList.remove('selected-cell'));
                } else {
                    selectedSet.add(colName);
                    header.classList.add('selected-column');
                    cells.forEach(cell => cell.classList.add('selected-cell'));
                }

                selectedInput.value = Array.from(selectedSet).join(',');
            });
        });
    });
</script>
