@page
@model RazorPage.Pages.IndexModel
@{
    ViewData["Title"] = "Class Management";
}

<div class="container">
    <div class="row">
        <!-- Sol tarafta Form -->
        <div class="col-md-4">
            <h2>@(Model.EditId.HasValue ? "Edit Class" : "Add New Class")</h2>
            <form method="post">
                <input type="hidden" asp-for="EditId" /> <!-- Düzenlenen öğenin ID'sini saklamak için -->

                <div class="form-group">
                    <label>Class Name</label>
                    <input type="text" asp-for="NewClass.ClassName" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Student Count</label>
                    <input type="number" asp-for="NewClass.StudentCount" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                </div>
                <button type="submit" class="btn btn-primary mt-2">
                    @(Model.EditId.HasValue ? "Update" : "Submit")
                </button>
            </form>
        </div>

        <!-- Sağ tarafta Tablo -->
        <div class="col-md-8">
            <h2>Class List</h2>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in RazorPage.Pages.IndexModel.ClassList)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post" asp-page-handler="Edit">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-primary">Edit</button>
                                </form>
                                <form method="post" asp-page-handler="Delete">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
