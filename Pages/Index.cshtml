@page
@model RazorPage.Pages.IndexModel
@{
    ViewData["Title"] = "Class Management";
}

<style>
    body {
        background: linear-gradient(to right, #dbeafe, #bfdbfe);
        color: #333;
        font-family: 'Poppins', sans-serif;
    }

    .container {
        margin-top: 30px;
    }

    .card {
        border-radius: 15px;
        box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.1);
        padding: 20px;
        background-color: white;
        transition: 0.3s;
    }

    .card:hover {
        transform: scale(1.02);
    }

    .table {
        background-color: white;
        border-radius: 10px;
        overflow: hidden;
        color: #333;
    }

    th {
        background-color: #3b82f6;
        color: white;
        text-transform: uppercase;
        cursor: pointer;
    }

    tr:nth-child(even) {
        background-color: #f1f5f9;
    }

    tr:hover {
        background-color: #e0f2fe;
        transition: 0.3s;
    }

    .btn-primary {
        background-color: #2563eb;
        border-color: #2563eb;
        border-radius: 10px;
        transition: 0.3s;
    }

    .btn-primary:hover {
        background-color: #1e40af;
    }

    .btn-danger {
        background-color: #ef4444;
        border-color: #ef4444;
        border-radius: 10px;
        transition: 0.3s;
    }

    .btn-danger:hover {
        background-color: #b91c1c;
    }

    .btn-success {
        background-color: #16a34a;
        border-color: #16a34a;
        border-radius: 10px;
        padding: 6px 14px;
        transition: 0.3s;
    }

    .btn-success:hover {
        background-color: #15803d;
    }

    .selected-header {
        background-color: #2563eb !important;
        color: white !important;
    }

    .highlight-column {
        background-color: #dbeafe !important;
    }

    .selected-header, .highlight-column {
        transition: background-color 0.2s ease-in-out;
    }
</style>

<div class="container">
    <div class="row">
        <!-- Form -->
        <div class="col-md-4">
            <div class="card">
                <h2 class="text-center text-primary">
                    @(Model.EditId.HasValue ? "Edit Class" : "Add New Class")
                </h2>
                <form method="post" asp-page-handler="@(Model.EditId.HasValue ? "Edit" : "Add")">
                    <input type="hidden" asp-for="EditId" />
                    <div class="form-group">
                        <label><strong>Class Name</strong></label>
                        <input type="text" asp-for="NewClass.ClassName" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label><strong>Student Count</strong></label>
                        <input type="number" asp-for="NewClass.StudentCount" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label><strong>Description</strong></label>
                        <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mt-3">
                        @(Model.EditId != null ? "Update" : "Add")
                    </button>
                </form>
            </div>
        </div>

        <!-- Table -->
        <div class="col-md-8">
            <div class="card">
                <!-- Class List title + Export button -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="text-primary mb-0">Class List</h2>
                    <form method="post" asp-page-handler="ExportCurrentPage" id="exportForm" class="mb-0">
                        <div id="selectedColumnsContainer"></div>
                        <button type="submit" class="btn btn-success">Export</button>
                    </form>
                </div>

                <!-- Filter -->
                <form method="get" class="mb-3 d-flex">
                    <input type="text" name="FilterByName" class="form-control mr-2" value="@Model.FilterByName"
                        placeholder="Filter by class name" />
                    <button type="submit" class="btn btn-primary">Filter</button>
                </form>

                <table class="table table-hover table-bordered" id="classTable">
                    <thead>
                        <tr>
                            <th data-column="Class Name">Class Name</th>
                            <th data-column="Student Count">Student Count</th>
                            <th data-column="Description">Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.FilteredClasses)
                        {
                            var classItem = RazorPage.Pages.IndexModel.ClassList
                                .FirstOrDefault(x => x.ClassName == item.ClassName && x.Description == item.Description);
                            if (classItem != null)
                            {
                                <tr>
                                    <td data-column="Class Name">@item.ClassName</td>
                                    <td data-column="Student Count">@item.StudentCount</td>
                                    <td data-column="Description">@item.Description</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <form method="post" asp-page-handler="StartEdit" class="mb-0">
                                                <input type="hidden" name="id" value="@classItem.Id" />
                                                <button type="submit" class="btn btn-primary btn-sm">Edit</button>
                                            </form>
                                            <form method="post" asp-page-handler="Delete" class="mb-0">
                                                <input type="hidden" name="id" value="@classItem.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <!-- Pagination -->
                <div class="text-center">
                    <p>Page @Model.PageNumber of @Model.TotalPages</p>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <a asp-page="./Index" asp-route-PageNumber="@i" asp-route-FilterByName="@Model.FilterByName"
                            class="btn btn-sm @(i == Model.PageNumber ? "btn-primary" : "btn-outline-primary") mx-1">
                            @i
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const headerCells = document.querySelectorAll('#classTable thead th[data-column]');
        const selectedColumns = new Set();
        const exportForm = document.getElementById('exportForm');
        const container = document.getElementById('selectedColumnsContainer');

        function updateColumnHighlighting() {
            document.querySelectorAll('[data-column]').forEach(cell => {
                cell.classList.remove('highlight-column');
            });
            document.querySelectorAll('#classTable thead th').forEach(th => {
                th.classList.remove('selected-header');
            });

            selectedColumns.forEach(columnName => {
                document.querySelectorAll(`[data-column="${columnName}"]`).forEach(cell => {
                    cell.classList.add('highlight-column');
                });
                document.querySelectorAll(`#classTable thead th[data-column="${columnName}"]`).forEach(th => {
                    th.classList.add('selected-header');
                });
            });
        }

        headerCells.forEach(th => {
            const columnName = th.getAttribute('data-column');

            th.addEventListener('click', () => {
                if (!selectedColumns.has(columnName)) {
                    selectedColumns.add(columnName);
                } else {
                    selectedColumns.delete(columnName);
                }

                updateColumnHighlighting();
            });
        });

        exportForm.addEventListener('submit', function () {
            container.innerHTML = '';
            Array.from(selectedColumns).forEach(column => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'selectedColumns';
                input.value = column;
                container.appendChild(input);
            });
        });

        updateColumnHighlighting();
    });
</script>
