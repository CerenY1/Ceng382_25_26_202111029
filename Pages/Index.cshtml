@page
@model RazorPage.Pages.IndexModel
@{
    ViewData["Title"] = "Class Management";
}

<style>
    body {
        background: linear-gradient(to right, #dbeafe, #bfdbfe);
        color: #333;
        font-family: 'Poppins', sans-serif;
    }

    .container {
        margin-top: 30px;
    }

    .card {
        border-radius: 15px;
        box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.1);
        padding: 20px;
        background-color: white;
        transition: 0.3s;
    }

    .card:hover {
        transform: scale(1.02);
    }

    .table {
        background-color: white;
        border-radius: 10px;
        overflow: hidden;
        color: #333;
    }

    th {
        background-color: #3b82f6;
        color: white;
        text-transform: uppercase;
    }

    tr:nth-child(even) {
        background-color: #f1f5f9;
    }

    tr:hover {
        background-color: #e0f2fe;
        transition: 0.3s;
    }

    /* Butonlar */
    .btn-primary {
        background-color: #2563eb;
        border-color: #2563eb;
        border-radius: 10px;
        transition: 0.3s;
    }

    .btn-primary:hover {
        background-color: #1e40af;
    }

    .btn-danger {
        background-color: #ef4444;
        border-color: #ef4444;
        border-radius: 10px;
        transition: 0.3s;
    }

    .btn-danger:hover {
        background-color: #b91c1c;
    }

</style>

<div class="container">
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <h2 class="text-center text-primary">
                    @(Model.EditId.HasValue ? "Edit Class" : "Add New Class")
                </h2>
                <form method="post" asp-page-handler="Edit">
                    
                    <input type="hidden" asp-for="EditId" />

                    <div class="form-group">
                        <label><strong>Class Name</strong></label>
                        <input type="text" asp-for="NewClass.ClassName" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label><strong>Student Count</strong></label>
                        <input type="number" asp-for="NewClass.StudentCount" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label><strong>Description</strong></label>
                        <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100 mt-3"
                            asp-page-handler="@(Model.EditId != null ? "Edit" : "Add")">
                        @(Model.EditId != null ? "Update" : "Add")
                    </button>
                </form>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card">
                <h2 class="text-center text-primary">Class List</h2>
                <table class="table table-hover table-bordered">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Class Name</th>
                            <th>Student Count</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in IndexModel.ClassList)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.ClassName</td>
                                <td>@item.StudentCount</td>
                                <td>@item.Description</td>
                                <td>
                                    <div class="d-flex justify-content-start">
                                        <form method="post" asp-page-handler="Edit" class="mr-2 mb-0">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-primary btn-sm">Edit</button>
                                        </form>
                                        <form method="post" asp-page-handler="Delete" class="mb-0">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>